    "homepage": "https://github.com/mikopbx/Core",
    "support": {
        "email": "help@mikopbx.com",
        "wiki": "https://wiki.mikopbx.com",
        "issues": "https://github.com/mikopbx/Core/issues",
        "forum": "https://qa.mikopbx.ru"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.14"
        }
    }
